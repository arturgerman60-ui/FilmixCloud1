# --- InvoiceForge configuration ---
# Скопируйте этот файл в .env и при необходимости измените значения.

# Пароль администратора для входа в панель.
INVOICEFORGE_PASSWORD=admin

# Секрет для подписи cookie-сессий (ОБЯЗАТЕЛЬНО смените на случайную строку).
INVOICEFORGE_SECRET=change-me-to-a-long-random-string

# Порт, на котором запускается приложение.
INVOICEFORGE_PORT=8000

# Папка для базы данных и загрузок (по умолчанию ./data).
INVOICEFORGE_DATA_DIR=data
