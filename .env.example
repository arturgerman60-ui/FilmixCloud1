# FunPay AutoResponder — environment overrides (optional)
# Copy to .env and adjust. Secrets are better stored via the OS keyring
# (handled automatically by the app), .env is only for advanced overrides.

# Log level: DEBUG | INFO | WARNING | ERROR
FPAR_LOG_LEVEL=INFO

# Force a data directory (default: ./data or %APPDATA%/FunPayAutoResponder)
# FPAR_DATA_DIR=

# AI backend: none | ollama | lmstudio
FPAR_AI_BACKEND=none
FPAR_AI_BASE_URL=http://localhost:11434
FPAR_AI_MODEL=llama3.1

# Run browser without opening a window
FPAR_HEADLESS=true
